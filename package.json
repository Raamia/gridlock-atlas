{
  "name": "gridlock-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "audit": "tsx scripts/audit-data.ts",
    "snapshot:build": "python3 scripts/ingest/region_b_to_clusters.py && tsx scripts/build-snapshot.ts",
    "sources:fetch": "python3 scripts/ingest/fetch_all.py",
    "extract": "python3 scripts/ingest/extract.py",
    "extract:openai": "python3 scripts/ingest/extract.py --provider openai",
    "extract:gemini": "python3 scripts/ingest/extract.py --provider gemini",
    "extract:eval": "python3 scripts/ingest/extract_eval.py",
    "eval": "tsx scripts/evaluate.ts",
    "check": "tsc --noEmit && eslint . && vitest run && tsx scripts/audit-data.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "@turf/along": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "mapbox-gl": "^3.31.0",
    "motion": "^12.43.0",
    "next": "16.3.6",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
